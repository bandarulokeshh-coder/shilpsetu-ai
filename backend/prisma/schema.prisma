generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(uuid())
  name                String
  email               String        @unique
  phone               String?
  password            String
  role                String        @default("ARTISAN")
  preferredLanguage   String        @default("en")
  location            String?
  craftType           String?
  bio                 String?
  avatar              String?
  isApproved          Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  products            Product[]
  enquiries           Enquiry[]
  orders              Order[]

  // AI Buyer Request -> Direct Artisan Matching
  buyerRequests       BuyerRequest[]
  buyerRequestArtisan ArtisanMatch[]
  buyerQuotes         Quote[]
  buyerConversations  Conversation[]

  assignedRequests    BuyerRequest[]
  artisanMatches      ArtisanMatch[]
  artisanQuotes       Quote[]
  conversationSender  Conversation[]
  conversationReceiver Conversation[]
}

model Product {
  id                  String        @id @default(uuid())
  artisanId           String
  artisan             User          @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  title               String
  description         String
  hindiDescription    String?
  englishDescription  String?
  category            String
  material            String
  dimensions          String?
  quantity            Int           @default(1)

  imageUrl            String?
  enhancedImageUrl    String?

  rawMaterialCost     Float         @default(0)
  labourCost          Float         @default(0)
  packagingCost       Float         @default(0)
  otherCost           Float         @default(0)

  minimumPrice        Float?
  suggestedPrice      Float?
  premiumPrice        Float?

  keywords            String?
  status              String        @default("DRAFT")

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  enquiries           Enquiry[]
  orderItems          OrderItem[]

  @@index([artisanId])
  @@index([status])
  @@index([category])
}

model Enquiry {
  id         String        @id @default(uuid())
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  quantity   Int           @default(1)
  message    String
  status     String        @default("PENDING")

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([productId])
  @@index([buyerId])
}

model Order {
  id              String      @id @default(uuid())
  buyerId         String
  buyer           User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  status          String      @default("PENDING") // PENDING | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  totalAmount     Float

  // Shipping address snapshot (kept on the order so later profile edits don't rewrite history)
  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  shippingPincode String

  items           OrderItem[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([buyerId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Denormalized snapshot so order history survives product edits/deletion
  artisanId   String
  artisanName String
  title       String
  imageUrl    String?
  unitPrice   Float
  quantity    Int

  @@index([orderId])
  @@index([productId])
  @@index([artisanId])
}

// ==========================================
// AI Buyer Request → Direct Artisan Matching
// ==========================================

model BuyerRequest {
  id                  String        @id @default(uuid())
  buyerId             String
  buyer               User          @relation("BuyerRequestBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  // Raw input
  description         String        // Natural language description
  type                String        @default("text") // text | voice | image
  inputMediaUrl       String?

  // AI extracted structured data (as JSON string for SQLite compatibility)
  extractedRequirements String      // JSON string with structured requirements

  // Matching & status
  status              String        @default("PENDING") // PENDING | MATCHED | QUOTE_RECEIVED | ORDER_CREATED | CLOSED
  assignedArtisanId   String?
  assignedArtisan     User?         @relation("BuyerRequestArtisan", fields: [assignedArtisanId], references: [id])

  // Auto-generated matches
  artisanMatches      ArtisanMatch[]

  // Quotes from artisans
  quotes              Quote[]

  // Conversation thread
  conversations       Conversation[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([buyerId])
  @@index([status])
  @@index([assignedArtisanId])
}

model ArtisanMatch {
  id                  String        @id @default(uuid())
  buyerRequestId      String
  buyerRequest        BuyerRequest  @relation(fields: [buyerRequestId], references: [id], onDelete: Cascade)

  artisanId           String
  artisan             User          @relation(fields: [artisanId], references: [id])

  // Matching score (0-100)
  matchScore          Int
  matchReason         String?       // Why this artisan was matched

  // Status
  status              String        @default("SUGGESTED") // SUGGESTED | ACCEPTED | REJECTED

  createdAt           DateTime      @default(now())

  @@index([buyerRequestId])
  @@index([artisanId])
  @@index([status])
}

model Quote {
  id                  String        @id @default(uuid())
  buyerRequestId      String
  buyerRequest        BuyerRequest  @relation(fields: [buyerRequestId], references: [id], onDelete: Cascade)

  artisanId           String
  artisan             User          @relation(fields: [artisanId], references: [id])

  // Quote details
  amount              Float
  currency            String        @default("INR")
  status              String        @default("PENDING") // PENDING | ACCEPTED | REJECTED | EXPIRED
  expiryDate          DateTime

  // Message from artisan
  message             String?

  // Negotiation history
  negotiationHistory  Json?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // One quote per artisan per buyer request
  @@unique([buyerRequestId, artisanId])
  @@index([buyerRequestId])
  @@index([artisanId])
  @@index([status])
}

model Conversation {
  id                  String        @id @default(uuid())
  buyerRequestId      String
  buyerRequest        BuyerRequest  @relation(fields: [buyerRequestId], references: [id], onDelete: Cascade)

  senderId            String
  sender              User          @relation(fields: [senderId], references: [id])

  receiverId          String
  receiver            User          @relation(fields: [receiverId], references: [id])

  message             String
  isTranslated        Boolean       @default(false)
  translatedMessage   String?
  language            String?       // Target language for translation

  isRead              Boolean       @default(false)
  readAt              DateTime?

  createdAt           DateTime      @default(now())

  @@index([buyerRequestId])
  @@index([senderId])
  @@index([receiverId])
}
