generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(uuid())
  name                String
  email               String        @unique
  phone               String?
  password            String
  role                String        @default("ARTISAN")
  preferredLanguage   String        @default("en")
  location            String?
  craftType           String?
  bio                 String?
  avatar              String?
  rating              Float?
  isApproved          Boolean       @default(true)

  // Identity verification — only the last 4 digits of the ID are ever stored
  verifiedAt          DateTime?
  idType              String?
  idLast4             String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  products            Product[] @relation("ProductArtisan")
  enquiries           Enquiry[] @relation("EnquiryBuyer")
  orders              Order[] @relation("OrderBuyer")

  // Address book
  addresses           Address[] @relation("UserAddresses")

  // Pickup locations (for artisans)
  pickupLocations     PickupLocation[] @relation("PickupLocationShipments")

  // Shipments (as buyer, artisan, or sender)
  shipmentBuyer       Shipment[] @relation("ShipmentBuyer")
  shipmentArtisan     Shipment[] @relation("ShipmentArtisan")

  // Returns (as buyer)
  returns             Return[] @relation("ReturnBuyer")

  // AI Buyer Request -> Direct Artisan Matching
  buyerRequests       BuyerRequest[] @relation("BuyerRequestBuyer")
  buyerRequestArtisan BuyerRequest[] @relation("BuyerRequestArtisan")
  buyerQuotes         Quote[] @relation("QuoteBuyer")
  buyerConversations  Conversation[] @relation("ConversationBuyer")
  buyerMatches        ArtisanMatch[] @relation("ArtisanMatchBuyer")

  artisanMatches      ArtisanMatch[] @relation("ArtisanMatchArtisan")
  artisanQuotes       Quote[] @relation("QuoteArtisan")
  conversationSender  Conversation[] @relation("ConversationSender")
  conversationReceiver Conversation[] @relation("ConversationReceiver")

  // Reviews
  reviewsGiven        Review[] @relation("ReviewBuyer")
  reviewsReceived     Review[] @relation("ReviewArtisan")
}

model Product {
  id                  String        @id @default(uuid())
  artisanId           String
  artisan             User          @relation("ProductArtisan", fields: [artisanId], references: [id], onDelete: Cascade)

  title               String
  description         String
  hindiDescription    String?
  englishDescription  String?
  category            String
  material            String
  dimensions          String?
  quantity            Int           @default(1)

  imageUrl            String?
  enhancedImageUrl    String?

  rawMaterialCost     Float         @default(0)
  labourCost          Float         @default(0)
  packagingCost       Float         @default(0)
  otherCost           Float         @default(0)

  minimumPrice        Float?
  suggestedPrice      Float?
  premiumPrice        Float?

  keywords            String?
  status              String        @default("DRAFT")

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  enquiries           Enquiry[] @relation("EnquiryProduct")
  orderItems          OrderItem[] @relation("OrderItemProduct")

  reviews             Review[] @relation("ProductReviews")

  @@index([artisanId])
  @@index([status])
  @@index([category])
}

// Buyer reviews of a product (and the artisan who made it)
model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation("ProductReviews", fields: [productId], references: [id], onDelete: Cascade)

  buyerId    String
  buyer      User     @relation("ReviewBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  artisanId  String
  artisan    User     @relation("ReviewArtisan", fields: [artisanId], references: [id], onDelete: Cascade)

  rating     Int
  comment    String?

  createdAt  DateTime @default(now())

  @@unique([productId, buyerId])
  @@index([productId])
  @@index([artisanId])
}

model Enquiry {
  id         String        @id @default(uuid())
  productId  String
  product    Product       @relation("EnquiryProduct", fields: [productId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      User          @relation("EnquiryBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  quantity   Int           @default(1)
  message    String
  status     String        @default("PENDING")

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([productId])
  @@index([buyerId])
}

model Order {
  id              String      @id @default(uuid())
  buyerId         String
  buyer           User        @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  status          String      @default("PENDING")
  totalAmount     Float

  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  shippingState   String?
  shippingPincode String
  shippingCountry String?

  items           OrderItem[] @relation("OrderItems")

  returns         Return[] @relation("OrderReturn")
  shipments       Shipment[] @relation("OrderShipments")

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([buyerId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation("OrderItems", fields: [orderId], references: [id], onDelete: Cascade)

  productId   String
  product     Product @relation("OrderItemProduct", fields: [productId], references: [id], onDelete: Cascade)

  artisanId   String
  artisanName String
  title       String
  imageUrl    String?
  unitPrice   Float
  quantity    Int

  @@index([orderId])
  @@index([productId])
  @@index([artisanId])
}

// ==========================================
// AI Buyer Request - Direct Artisan Matching
// ==========================================

model BuyerRequest {
  id                  String        @id @default(uuid())
  buyerId             String
  buyer               User          @relation("BuyerRequestBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  title               String        @default("")
  description         String
  category            String?
  material            String?
  quantity            Int           @default(1)
  maxBudget           Float?
  deadline            DateTime?
  attachments         String?
  type                String        @default("text")
  inputMediaUrl       String?

  extractedRequirements String

  status              String        @default("PENDING")
  assignedArtisanId   String?
  assignedArtisan     User?         @relation("BuyerRequestArtisan", fields: [assignedArtisanId], references: [id])

  artisanMatches      ArtisanMatch[] @relation("ArtisanMatchBuyerRequest")
  quotes              Quote[] @relation("QuoteBuyerRequest")

  conversations       Conversation[] @relation("ConversationBuyerRequest")

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([buyerId])
  @@index([status])
  @@index([assignedArtisanId])
}

model ArtisanMatch {
  id                  String        @id @default(uuid())
  buyerRequestId      String
  buyerRequest        BuyerRequest  @relation("ArtisanMatchBuyerRequest", fields: [buyerRequestId], references: [id], onDelete: Cascade)

  buyerId             String
  buyer               User          @relation("ArtisanMatchBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  artisanId           String
  artisan             User          @relation("ArtisanMatchArtisan", fields: [artisanId], references: [id])

  matchScore          Int
  matchReason         String?

  status              String        @default("SUGGESTED")

  createdAt           DateTime      @default(now())

  @@index([buyerRequestId])
  @@index([buyerId])
  @@index([artisanId])
  @@index([status])
}

model Quote {
  id                  String        @id @default(uuid())
  buyerRequestId      String
  buyerRequest        BuyerRequest  @relation("QuoteBuyerRequest", fields: [buyerRequestId], references: [id], onDelete: Cascade)

  buyerId             String
  buyer               User          @relation("QuoteBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  artisanId           String
  artisan             User          @relation("QuoteArtisan", fields: [artisanId], references: [id])

  amount              Float
  currency            String        @default("INR")
  status              String        @default("PENDING")
  expiryDate          DateTime

  message             String?

  negotiationHistory  String?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([buyerRequestId, artisanId])
  @@index([buyerRequestId])
  @@index([buyerId])
  @@index([artisanId])
  @@index([status])
}

model Conversation {
  id                  String        @id @default(uuid())
  buyerRequestId      String
  buyerRequest        BuyerRequest  @relation("ConversationBuyerRequest", fields: [buyerRequestId], references: [id], onDelete: Cascade)

  buyerId             String
  buyer               User          @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  senderId            String
  sender              User          @relation("ConversationSender", fields: [senderId], references: [id])

  receiverId          String
  receiver            User          @relation("ConversationReceiver", fields: [receiverId], references: [id])

  message             String
  attachments         String?
  isTranslated        Boolean       @default(false)
  translatedMessage   String?
  language            String?

  isRead              Boolean       @default(false)
  readAt              DateTime?

  createdAt           DateTime      @default(now())

  @@index([buyerRequestId])
  @@index([buyerId])
  @@index([senderId])
  @@index([receiverId])
}

// ==========================================
// Logistics & Delivery System
// ==========================================

model Address {
  id           String  @id @default(uuid())
  userId       String
  user         User? @relation("UserAddresses", fields: [userId], references: [id])

  name         String?
  type         String  @default("shipping")
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String  @default("India")
  phone        String
  landmark     String?
  isDefault    Boolean @default(false)

  coordinates String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments   Shipment[] @relation("AddressShipments")

  @@index([userId])
  @@index([type])
  @@index([isDefault])
}

model PickupLocation {
  id           String  @id @default(uuid())
  artisanId    String
  artisan      User    @relation("PickupLocationShipments", fields: [artisanId], references: [id], onDelete: Cascade)

  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String @default("India")
  phone        String
  landmark     String?
  isDefault    Boolean @default(false)

  coordinates String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[] @relation("PickupLocationShipments")

  @@index([artisanId])
  @@index([isDefault])
}

model Shipment {
  id                      String  @id @default(uuid())
  orderId                 String
  order                   Order   @relation("OrderShipments", fields: [orderId], references: [id])

  buyerId                 String
  buyer                   User    @relation("ShipmentBuyer", fields: [buyerId], references: [id])

  artisanId               String
  artisan                 User    @relation("ShipmentArtisan", fields: [artisanId], references: [id])

  pickupLocationId        String?
  pickupLocation          PickupLocation? @relation("PickupLocationShipments", fields: [pickupLocationId], references: [id], onDelete: SetNull)

  status                  String  @default("ORDER_PLACED")

  trackingId              String?
  courierName             String?
  shippingCost            Float   @default(0)
  weightKg                Float?
  dimensions              String?
  packageCount            Int?
  scheduledPickupDate     DateTime?
  actualPickupDate        DateTime?
  estimatedDeliveryDate   DateTime?
  actualDeliveryDate      DateTime?

  deliveryAddressSnapshot String

  proofOfDelivery         String?

  notes                   String?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  events                  ShipmentEvent[] @relation("ShipmentEvents")
  returns                 Return[] @relation("ShipmentReturns")

  returnShipmentId        String?
  returnShipment          Shipment? @relation("ShipmentSelfReturn", fields: [returnShipmentId], references: [id], onDelete: SetNull)
  returnShipmentments     Shipment[] @relation("ShipmentSelfReturn")
  returnShipments         Return[] @relation("ReturnReturnShipment")

  addressId               String?
  address                 Address? @relation("AddressShipments", fields: [addressId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([buyerId])
  @@index([artisanId])
  @@index([status])
  @@index([trackingId])
}

model ShipmentEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation("ShipmentEvents", fields: [shipmentId], references: [id], onDelete: Cascade)

  eventId     String?
  eventType   String
  status      String
  location    String?
  description String
  notes       String?
  timestamp   DateTime

  createdAt   DateTime @default(now())

  @@index([shipmentId])
  @@index([eventType])
  @@index([timestamp])
}

model Return {
  id              String   @id @default(uuid())
  shipmentId      String
  shipment        Shipment @relation("ShipmentReturns", fields: [shipmentId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order    @relation("OrderReturn", fields: [orderId], references: [id], onDelete: Cascade)
  buyerId         String
  buyer           User     @relation("ReturnBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  reason          String
  description     String?
  status          String   @default("REQUESTED")
  refundAmount    Float    @default(0)
  refundProcessedAt DateTime?

  returnShipmentId String?
  returnShipment   Shipment? @relation("ReturnReturnShipment", fields: [returnShipmentId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shipmentId])
  @@index([orderId])
  @@index([buyerId])
  @@index([status])
}
